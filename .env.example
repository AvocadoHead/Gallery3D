# Aether Gallery — environment variables
# Copy this file to `.env.local` and fill in your own values.

# --- Supabase (required for login, saving & sharing galleries) ---
# Create a free project at https://supabase.com, then find these under
# Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Drive API (optional) ---
# Enables full-resolution Google Drive images in the lightbox. Create a key at
# https://console.cloud.google.com (enable "Google Drive API"). Leave blank to
# fall back to Drive's thumbnail/preview player.
VITE_GOOGLE_API_KEY=
